<Project Sdk="Microsoft.NET.Sdk">

  <!--
    14-01 Task 2: the SEPARATE net10 unit-test project for the MCP host's non-protocol
    contracts. It CANNOT be net472 (Pitfall 1) — it project-references the net10 Utinni.Mcp.
    Carries the Wave-0 suite: SC3 path-escape (ResolvedRoot), arg parsing (ServerArgs),
    deterministic absolute CLI locator (CliLocator), and dispatcher timeout/exe-missing/
    large-stdout (CliDispatcher). Runs on the net10 `dotnet test` CI lane, NOT the x86 pass.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Utinni.Mcp.Tests</RootNamespace>
    <AssemblyName>Utinni.Mcp.Tests</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utinni.Mcp\Utinni.Mcp.csproj" />
    <ProjectReference Include="..\UtinniCoreDotNet.PathContainment\UtinniCoreDotNet.PathContainment.csproj" />
  </ItemGroup>

  <!--
    14-04 Task 1 (Consensus #8): the MINIMAL real binary fixtures the net10 RoundTripTests copy
    into a temp resolved-root and drive the built server against. The net10 project CANNOT
    reference the net472 builders, so the bytes are committed (provenance in Fixtures/README.md)
    and copied to the test output dir so the RoundTripTests resolve them via AppContext.BaseDirectory.
  -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    16-03 Task 3 (A): link the CANONICAL pipe-name/framing fixture + the four GOLDEN WIRE
    byte-vectors from Utinni.Cli.Tests/Fixtures/live/. Link form (not a fork) so the SAME
    committed files the net472 server-side suite (16-02) asserts byte-exact against are ALSO the
    files this net10 client-side suite asserts against — the cross-TFM agreement anchors (R3-1).
    The net10 CanonicalJson must produce the request goldens + consume the ack goldens byte-exact.
  -->
  <ItemGroup>
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\pipe-name.txt" Link="Fixtures\live\pipe-name.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-ping-request.json" Link="Fixtures\live\wire-ping-request.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-ping-ack.json" Link="Fixtures\live\wire-ping-ack.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-reload-request.json" Link="Fixtures\live\wire-reload-request.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-reload-ack.json" Link="Fixtures\live\wire-reload-ack.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

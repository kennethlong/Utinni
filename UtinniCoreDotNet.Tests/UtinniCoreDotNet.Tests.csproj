<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <!-- Without this, SDK-style emits to bin\x86\Release\net472\ when built via
         msbuild /p:Platform=x86, but `dotnet test` (with the no-build flag)
         probes bin\Release\net472\. Omitting Platform from the path keeps the
         build output and the test discovery in sync. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>UtinniCoreDotNet.Tests</RootNamespace>
    <AssemblyName>UtinniCoreDotNet.Tests</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Fixtures/{BrokenPlugin,GoodPlugin}/ have their own csprojs that produce
         their own obj/Release/net472/*.AssemblyInfo.cs (SDK-style auto-gen).
         Without this exclude, this project's default Compile glob (**/*.cs)
         picks up the Fixtures' AssemblyInfo files AND generates its own,
         failing with CS0579 duplicate-attribute errors. CI happens to win the
         parallel-/m race (Tests's Compile evaluated before Fixtures' obj/
         materialises); local builds often lose it. Excluding the subtree
         from the SDK default-item globs is the correct fix — the Fixtures
         build via their own csproj entries in Utinni.sln. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Fixtures\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UtinniCoreDotNet\UtinniCoreDotNet.csproj" />
  </ItemGroup>

  <!-- 16-02 Task 1a: link the CANONICAL pipe-name/framing fixture + the four GOLDEN WIRE
       byte-vectors from Utinni.Cli.Tests/Fixtures/live/. Link form (not a copy) so the SAME
       committed files this net472 server-side suite asserts byte-exact against are ALSO the files
       the 16-03 net10 client side asserts against — the cross-TFM agreement anchors (R3-1).
       CopyToOutputDirectory so the tests can read them by relative path under Fixtures\live\. -->
  <ItemGroup>
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\pipe-name.txt" Link="Fixtures\live\pipe-name.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-ping-request.json" Link="Fixtures\live\wire-ping-request.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-ping-ack.json" Link="Fixtures\live\wire-ping-ack.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-reload-request.json" Link="Fixtures\live\wire-reload-request.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Utinni.Cli.Tests\Fixtures\live\wire-reload-ack.json" Link="Fixtures\live\wire-reload-ack.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- C-15 tests target SlnDirResolver, a pure-function helper. We CANNOT take a
       ProjectReference to UtinniCoreDotNetGen.csproj because that project must build
       AnyCPU/x64 (its CppSharp deps are AMD64), and the Tests project runs x86 —
       loading the x64 exe into an x86 process throws BadImageFormatException at
       JIT time. Linking the .cs file compiles SlnDirResolver directly into
       UtinniCoreDotNet.Tests.dll so the test sees its own bitness-matched copy.
       Phase 3 R-F extends the same pattern to HeaderDiscovery for the
       HeaderDiscoveryTests fixture tests. -->
  <ItemGroup>
    <Compile Include="..\UtinniCoreDotNetGen\SlnDirResolver.cs" Link="SlnDirResolver.cs" />
    <Compile Include="..\UtinniCoreDotNetGen\HeaderDiscovery.cs" Link="HeaderDiscovery.cs" />
    <!-- Phase 3 R-G: link Props.cs into the Tests project so
         DirectoryBuildPropsTests can call Props.CreateDotNetDirectoryProps
         directly. A ProjectReference to Vsix.csproj is impractical: that
         project carries the VsixV3 ProjectTypeGuid and pulls in
         Microsoft.VisualStudio.SDK build-tooling that the test runner does not
         need. The linked-source pattern matches SlnDirResolver / HeaderDiscovery
         above; Props.cs is dependency-free (System.IO + System.Xml.Linq only).
         -->
    <Compile Include="..\sdk\UtinniPluginTemplates\Vsix\Utility\Props.cs" Link="Vsix\Props.cs" />
    <!-- Phase 8 Plan 07 Task 2 PART C: link TreFixtureBuilder.cs from
         Utinni.Cli.Tests/Infrastructure/ so this test project (and the new
         TreWriterTests in particular) can synthesize deterministic .tre
         fixtures without taking a ProjectReference to Utinni.Cli.Tests
         (which would couple two test assemblies). TreFixtureBuilder.cs is
         dependency-free (System.IO + System.IO.Compression + System.Text only)
         — same constraint that lets Props.cs link cleanly. Closes the
         round-2 HIGH-A csproj coverage requirement for the linked-source
         pattern documented in 08-07-PLAN.md PART C. -->
    <Compile Include="..\Utinni.Cli.Tests\Infrastructure\TreFixtureBuilder.cs" Link="Infrastructure\TreFixtureBuilder.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- HotkeyTests.cs uses Keys enum and key chord syntax from System.Windows.Forms,
         mirroring the production UtinniCoreDotNet.csproj which also declares this reference. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Phase 2 CI fix: P/Invoke tests load UtinniCore.dll (the native DLL produced by
       UtinniCore.vcxproj at $(SolutionDir)bin\$(Configuration)\). DllImport probes the
       test-process directory first, which is $(TargetDir) here — so copy the native
       artifacts next to the test assembly. LoaderLockHarnessTests also runs
       Utinni.LoaderLockHarness.exe via Process.Start; co-locating it ensures the
       harness finds UtinniCore.dll in its own directory (Win32 LoadLibrary search). -->
  <Target Name="CopyNativeArtifactsForTests" AfterTargets="Build">
    <ItemGroup>
      <_NativeTestArtifacts Include="$(SolutionDir)bin\$(Configuration)\UtinniCore.dll" />
      <_NativeTestArtifacts Include="$(SolutionDir)bin\$(Configuration)\Utinni.LoaderLockHarness.exe" />
      <!-- Phase 3 R-B fixture DLLs (Plan 03-02 Task 1): both are LoadLibrary'd at
           runtime by PluginManagerLifecycleTests via a P/Invoke bridge that
           points PluginManager at a temp Plugins/ directory. Co-locating the DLLs
           next to UtinniCore.dll ensures Win32 LoadLibrary's directory search
           finds them. -->
      <_NativeTestArtifacts Include="$(SolutionDir)bin\$(Configuration)\Utinni.CrtMatchPlugin.dll" />
      <_NativeTestArtifacts Include="$(SolutionDir)bin\$(Configuration)\Utinni.LegacyPlugin.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeTestArtifacts)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_NativeTestArtifacts.Identity)')" />
  </Target>
</Project>

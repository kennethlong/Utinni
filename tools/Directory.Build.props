<?xml version="1.0" encoding="utf-8"?>
<!-- Utinni 12-01/12-02 standalone-build shim. Lifted SOE vcxprojs use $(SolutionDir)..\..\ include
     paths authored for swg-client-v2 solution depth (broken for tools/). This file (auto-imported by
     every project under tools/) prepends the real include/public roots so transitive includes resolve
     CI-durably. Header search only; byte-exact determinant is the linked zlib.lib 1.1.4 (PINNED-SHA.md). -->
<Project>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src\engine\shared\library\sharedCollision\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedCompression\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedDebug\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedFile\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedFoundation\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedFoundationTypes\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedFractal\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedGame\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedImage\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedIoWin\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedLog\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedMath\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedMathArchive\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedMemoryManager\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedMessageDispatch\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedNetwork\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedNetworkMessages\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedObject\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedPathfinding\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedRandom\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedRegex\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedSkillSystem\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedSwitcher\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedSynchronization\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedTemplate\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedTemplateDefinition\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedTerrain\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedThread\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedUtility\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedXml\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\fileInterface\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\localizationArchive\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\unicodeArchive\include\public;$(MSBuildThisFileDirectory)src\game\shared\library\swgSharedNetworkMessages\include\public;$(MSBuildThisFileDirectory)src\game\shared\library\swgSharedUtility\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\localization\include;$(MSBuildThisFileDirectory)src\external\ours\library\unicode\include;$(MSBuildThisFileDirectory)src\external\3rd\library\zlib\include;$(MSBuildThisFileDirectory)src\external\3rd\library\zlib-1.2.3;$(MSBuildThisFileDirectory)src\external\3rd\library\debugHelp;$(MSBuildThisFileDirectory)src\external\3rd\library\vtune;$(MSBuildThisFileDirectory)src\external\3rd\library\boost;$(MSBuildThisFileDirectory)src\external\3rd\library\libxml\include;$(MSBuildThisFileDirectory)src\external\3rd\library\pcre\4.1\win32\include;$(MSBuildThisFileDirectory)src\external\3rd\library\perforce\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Utinni 12-01: decouple sharedLog crash-handler tail-log flush from SetupSharedFoundation
           (sharedLog -> sharedNetworkMessages -> Archive game-registry cascade). Minidump preserved. -->
      <PreprocessorDefinitions>UTINNI_TOOLS_NO_SHAREDLOG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- Utinni 12-02: the 2002-era Perforce libsupp.lib references _fscanf (and peers) which
           UCRT made inline and no longer exports. legacy_stdio_definitions.lib re-supplies those
           legacy stdio symbols. Harmless to EXEs that do not reference them (e.g. TreeFileBuilder). -->
      <AdditionalDependencies>legacy_stdio_definitions.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>

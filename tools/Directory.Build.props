<?xml version="1.0" encoding="utf-8"?>
<!-- Utinni 12-01 standalone-build shim. The lifted SOE vcxprojs locate sibling
     headers via $(SolutionDir)..\..\<lib>\include\public, authored for swg-client-v2's
     solution depth. Our tools/Utinni.Tools.sln sits at tools/, so those entries resolve
     outside the tree (cl.exe silently skips missing dirs). This file is auto-imported by
     every project under tools/ and prepends the real include/public roots of the lifted
     closure so transitive includes resolve regardless of build CWD / sln location
     (CI-durable). Header search only; no compiled-output-byte impact (byte-exact
     determinant is the linked zlib.lib 1.1.4 - see PINNED-SHA.md). -->
<Project>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src\engine\shared\library\sharedCompression\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedDebug\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedFile\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedFoundation\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedFoundationTypes\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedIoWin\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedMath\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedMathArchive\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedMemoryManager\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedRandom\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedSynchronization\include\public;$(MSBuildThisFileDirectory)src\engine\shared\library\sharedThread\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\fileInterface\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\localizationArchive\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\unicodeArchive\include\public;$(MSBuildThisFileDirectory)src\external\ours\library\localization\include;$(MSBuildThisFileDirectory)src\external\ours\library\unicode\include;$(MSBuildThisFileDirectory)src\external\3rd\library\zlib\include;$(MSBuildThisFileDirectory)src\external\3rd\library\zlib-1.2.3;$(MSBuildThisFileDirectory)src\external\3rd\library\debugHelp;$(MSBuildThisFileDirectory)src\external\3rd\library\vtune;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Utinni 12-01: decouple sharedLog from the standalone headless tools build. Its only
           consumer was SetupSharedFoundation's crash-handler tail-log flush, whose sharedLog ->
           sharedNetworkMessages -> Archive (game serialization registry, via archive's
           FirstArchive.h PCH) cascade would otherwise drag most of the game+engine into a
           file-packing tool. Minidump path is preserved; only the tail-log flush is dropped. -->
      <PreprocessorDefinitions>UTINNI_TOOLS_NO_SHAREDLOG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>

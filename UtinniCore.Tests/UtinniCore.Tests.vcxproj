    <!-- Phase 18 / RNDR-01 D-07 (Option-A split): compile the DX9-FREE half of the
         seam DIRECTLY into the test exe so render_backend::set/get link without the
         import lib. The zero-export seam (CPPS-04) is NOT in UtinniCore.lib, and the
         DX9-bearing half (render_backend_dx9.cpp) is deliberately NOT compiled here;
         it would drag in directX, DetourXS, and DepthTexture (LNK2019 cascade). -->
    <ClCompile Include="..\UtinniCore\swg\graphics\render_backend.cpp" />
    <!-- Phase 24 / EPA-02, EPA-04 D-03b: the swg::endpoints resolver unit harness.
         Pull the resolver TU in DIRECTLY (same pattern as render_backend.cpp above)
         so the pure resolve() is compiled + tested standalone; it relies on the lean
         endpoints.h (only utinni_engine_hookpoints.h + <cstddef>). The extern
         config/graphics pFn literals + utinni::log::* resolve against UtinniCore.lib
         (the test already links it). -->
    <ClCompile Include="endpoints_tests.cpp" />
    <ClCompile Include="..\UtinniCore\swg\endpoints.cpp" />
